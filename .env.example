# This file documents names only. Never put real credentials or Zcash key
# material in version control. Production values belong in a secret manager.
OBLIQ_DEPLOYMENT_MODE=development
DATABASE_URL=postgresql://obliq:obliq@127.0.0.1:5433/obliq
OBLIQ_APP_BASE_URL=http://127.0.0.1:3000
OBLIQ_SESSION_PEPPER=replace-with-at-least-32-random-bytes
OBLIQ_PROOF_ORGANIZATION_ID=00000000-0000-4000-8000-000000000002

# Authentication. Development identity is rejected when deployment mode is
# production. Production OIDC identities must be pre-provisioned in the DB.
OBLIQ_SESSION_MODE=development
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# Invoice objects. Production requires s3-private and a real HTTPS scanner.
OBLIQ_STORAGE_MODE=local-development
OBLIQ_UPLOAD_DIR=.data/uploads
OBLIQ_MAX_UPLOAD_BYTES=10485760
OBLIQ_STORAGE_BUCKET=replace-me
OBLIQ_STORAGE_REGION=replace-me
# OBLIQ_STORAGE_ENDPOINT=https://s3-compatible.example.com
# OBLIQ_STORAGE_KMS_KEY_ID=replace-me
OBLIQ_DOCUMENT_SCANNER_URL=https://scanner.example.com/scan
OBLIQ_DOCUMENT_SCANNER_TOKEN=replace-me

# Explicit development identity only.
OBLIQ_DEV_USER_ID=00000000-0000-4000-8000-000000000001
OBLIQ_DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000002
NEXT_PUBLIC_APP_ENV=development
OBLIQ_SERVER_ACTION_ALLOWED_ORIGINS=127.0.0.1:3000

# Read-only observer settings. Supply OBSERVER_UFVK from a secret manager only;
# never store viewing authority in this file or expose it to NEXT_PUBLIC_*.
OBLIQ_ZCASH_NETWORK=regtest
OBLIQ_PUBLIC_NETWORK_STATUS=PUBLIC_NETWORK_BLOCKED
OBSERVER_ENDPOINT=http://127.0.0.1:28137
OBSERVER_DB=.data/zcash-observer/wallet.sqlite
OBSERVER_BINARY=tools/zcash-observer/target/release/obliq-zcash-observer
OBSERVER_NETWORK=regtest
OBLIQ_OBSERVER_ACTOR_ID=00000000-0000-4000-8000-000000000001
OBLIQ_OBSERVER_ORGANIZATION_ID=00000000-0000-4000-8000-000000000002
